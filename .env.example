# ----------------------------------------------------------------------------
# HUGGINGFACE CONFIGURATION
# ----------------------------------------------------------------------------

# Repository ID on HuggingFace Hub (e.g., username/dataset-name)
ENV_HF_REPO_ID=your-username/your-dataset

# HuggingFace Access Token (Required. Must have write permissions for the repo)
ENV_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# UPLOAD API CONFIGURATION
# ----------------------------------------------------------------------------

# Base URL of the destination API (No trailing slash)
ENV_API_BASE_URL=https://api.your-domain.com

# API Login Credentials
ENV_API_USERNAME=your_api_username
ENV_API_PASSWORD=your_api_password

# ----------------------------------------------------------------------------
# METADATA TEMPLATE
# ----------------------------------------------------------------------------

# Either provide TEMPLATE_NAME or TEMPLATE_ID. 
# If both are provided, TEMPLATE_ID takes precedence.
ENV_TEMPLATE_NAME=Audio/Text Dataset Metadata
ENV_TEMPLATE_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------------
# BATCH PROCESSING
# ----------------------------------------------------------------------------

# Number of files to process concurrently within a single batch
ENV_BATCH_SIZE=5

# Seconds to wait between batches (Prevents API rate-limiting)
ENV_BATCH_DELAY_SECONDS=10

# ----------------------------------------------------------------------------
# PERFORMANCE & SAFETY CONTROLS
# ----------------------------------------------------------------------------

# SKIP fetching the full HF remote file list. 
# Set to 'true' ONLY if your HF repo has >50,000 files to speed up startup.
ENV_HF_SKIP_REMOTE_FILE_LIST=false

# The script randomly picks a number between LOWER and UPPER to upload per run.
# This allows incremental processing via cron jobs.
# Set both to 999999 if you want to upload ALL new files in one go.
ENV_RUN_UPLOAD_LOWER_BOUND=100
ENV_RUN_UPLOAD_UPPER_BOUND=150